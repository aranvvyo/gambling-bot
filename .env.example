# Discord developer portal credentials (required to run)
# Required: enter only in the hosting panel secret manager or a local ignored .env file.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
ADMIN_USER_IDS=
OWNER_USER_IDS=
ADMIN_CHANNEL_ID=
FAIRNESS_ROTATION_SECONDS=1800
WITHDRAWALS_ENABLED=false
WITHDRAWAL_LOG_CHANNEL_ID=
GENERAL_LOG_CHANNEL_ID=
LOSS_LOG_CHANNEL_ID=
WINS_LOG_CHANNEL_ID=
DEPOSIT_LOG_CHANNEL_ID=
BET_LOG_CHANNEL_ID=
ADMIN_LOG_CHANNEL_ID=
SECURITY_LOG_CHANNEL_ID=
ERROR_LOG_CHANNEL_ID=
FAIRNESS_LOG_CHANNEL_ID=

# Casino economy
# Bets use whole virtual-credit units. MIN_BET=1 is the smallest supported unit; no USD conversion is implied.
CASINO_NAME=Emerald Vault
CURRENCY_SYMBOL=VC
MIN_BET=1
# 0 means no per-bet cap; daily wager and payout caps still apply.
MAX_BET=0
MAX_PAYOUT=1000000
DAILY_BET_LIMIT=50000
HOUSE_EDGE=0.01
MAINTENANCE_MODE=false
BRAND_COLOR=0x1D9A6C
CASINO_BANNER_URL=
MINES_IMAGE_URL=
BLACKJACK_IMAGE_URL=
DRAGON_TOWER_IMAGE_URL=
CRASH_IMAGE_URL=
LIMBO_IMAGE_URL=
LIMO_IMAGE_URL=
DICE_IMAGE_URL=
CHICKEN_ROAD_IMAGE_URL=
PUMP_IMAGE_URL=

# SQLite; PostgreSQL adapter is not implemented
DATABASE_URL=sqlite:///casino.db

# Apirone invoice polling; credentials are never shown in Discord
# Optional for live invoices: enter both only in the hosting panel secret manager or a local ignored .env file.
APIRONE_ACCOUNT_ID=
APIRONE_TRANSFER_KEY=
DEPOSITS_ENABLED=false
# Leave false until credentials/rates and live provider verification have been reviewed.
DEPOSITS_LIVE_VERIFIED=false
APIRONE_INVOICE_LIFETIME=3600
APIRONE_POLL_INTERVAL=45
MIN_DEPOSIT=0.00001
MAX_DEPOSIT=10000
MAX_DEPOSIT_CREDIT=1000000
# Explicit virtual credits per whole coin; zero holds confirmed deposits for review
VC_PER_LTC=0
VC_PER_USDT_BEP20=0
VC_PER_USDT_ERC20=0

LOG_LEVEL=INFO

# Manual VC per-coin conversion rate timestamps (Unix seconds, refresh before expiry)
VC_RATE_UPDATED_AT_LTC=0
VC_RATE_UPDATED_AT_USDT_BEP20=0
VC_RATE_UPDATED_AT_USDT_ERC20=0
VC_RATE_MAX_AGE_SECONDS=3600
VC_RATE_SOURCE_LTC=
VC_RATE_SOURCE_USDT_BEP20=
VC_RATE_SOURCE_USDT_ERC20=

# Set to 0 to disable daily rewards
DAILY_REWARD=100
